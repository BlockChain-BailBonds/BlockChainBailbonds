{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://918tech.example/m3rma1d-s1r3n/codex/schemas/app-capability-plan.schema.json",
  "title": "M3rMa1d New App Capability Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["app_id", "functions"],
  "properties": {
    "app_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "risk", "confidence", "evidence"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$"},
          "description": {"type": "string", "minLength": 3, "maxLength": 256},
          "risk": {"type": "string", "enum": ["observe", "local_state", "physical_output", "transmit", "restricted"]},
          "confidence": {"type": "string", "enum": ["verified_metadata", "inferred", "unknown"]},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 512},
          "arguments_hint": {"type": "object"}
        }
      }
    }
  }
}
