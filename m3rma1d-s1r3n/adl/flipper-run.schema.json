{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://918tech.example/m3rma1d-s1r3n/adl/flipper-run.schema.json",
  "title": "M3rMa1d S1r3n ADL Flipper Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["adl_version", "run_id", "target", "steps"],
  "properties": {
    "adl_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._:-]+$"},
    "target": {"const": "flipper"},
    "description": {"type": "string", "maxLength": 256},
    "max_run_ms": {"type": "integer", "minimum": 100, "maximum": 30000, "default": 10000},
    "stop_on_error": {"type": "boolean", "default": true},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[A-Za-z0-9._:-]+$"},
          "capability": {
            "type": "string",
            "enum": ["help", "device_info", "storage_info", "loader_list", "gpio_read", "ir_transmit"]
          },
          "argument": {"type": "string", "maxLength": 64, "default": ""},
          "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 5000, "default": 2000},
          "approval": {"type": "string", "enum": ["none", "deck"], "default": "none"}
        }
      }
    }
  }
}
