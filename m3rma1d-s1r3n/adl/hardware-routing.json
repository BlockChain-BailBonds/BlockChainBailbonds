{
  "routing_version": "2.0",
  "logical_target": "flipper",
  "physical_owner": "s3-cam",
  "topology": ["s3-cam", "flipper-zero"],
  "bridge": {
    "interface": "uart",
    "baud": 230400,
    "format": "8N1",
    "s3_rx_gpio": 1,
    "s3_tx_gpio": 2,
    "flipper_tx_pin": 13,
    "flipper_rx_pin": 14,
    "common_ground_required": true,
    "power_connection": false
  },
  "codex": {
    "mode": "autonomous_registered_capabilities",
    "shell": false,
    "raw_cli": false,
    "requires_verified_adapter": true,
    "requires_active_lease": true,
    "stop_preempts_all": true,
    "approval_policy": {
      "observe": "automatic",
      "local_state": "automatic",
      "physical_output": "policy",
      "transmit": "policy_and_declared_asset",
      "restricted": "deny"
    }
  },
  "failure_mode": "fail_closed",
  "fallback_physical_route": false
}
