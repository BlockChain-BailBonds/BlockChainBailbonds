# Copy to .env only if a local tool explicitly requires a token.
# Never commit .env or paste tokens into source files.
GITHUB_TOKEN=
BAILBONDS_ADMIN_TOKEN=
BAILBONDS_ADMIN_EMAIL=
BAILBONDS_ADMIN_PASSWORD_HASH=
ADTV_REVENUE_WEBHOOK_SECRET=
BBT_UNITS_PER_USD_CENT=1
BBT_ASSET_SYMBOL=BBT

# Non-custodial EVM wallet billing; keep RPC URLs and payment address in the backend secret manager.
CRYPTO_PAYMENT_ADDRESS=
CRYPTO_RPC_URL=
CRYPTO_CHAIN_ID=0x1
CRYPTO_ASSET=native
CRYPTO_PRICE_STARTER_WEI=
CRYPTO_PRICE_PROFESSIONAL_WEI=
CRYPTO_PRICE_AGENCY_WEI=

# Utility accounting pegs (integer cents): 1 918 = $1,000; 1 BBT = $0.10
TOKEN_918_USD_CENTS=100000
TOKEN_BBT_USD_CENTS=10
TOKEN_TIER_PREPARED_MIN_USD_CENTS=10
TOKEN_TIER_STANDARD_MIN_USD_CENTS=10000
TOKEN_TIER_PRIORITY_MIN_USD_CENTS=100000
TOKEN_STANDARD_MAX_PREAPPROVED_USD=0
TOKEN_PRIORITY_MAX_PREAPPROVED_USD=0
