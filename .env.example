# Copy to .env only if a local tool explicitly requires a token.
# Never commit .env or paste tokens into source files.
GITHUB_TOKEN=
BAILBONDS_ADMIN_TOKEN=
BAILBONDS_ADMIN_EMAIL=
BAILBONDS_ADMIN_PASSWORD_HASH=

# Tulsa County booking source. This must be a deployment of the Code for Tulsa
# JSON wrapper (it exposes GET /inmateBooking and refreshes the public PDF hourly).
# Example local deployment: http://127.0.0.1:3030
TULSA_INMATE_API_URL=
# Current official county portal used when the retired export reports migration.
# Do not automate or bypass its CAPTCHA; route licensed staff to this page.
TULSA_BOOKING_PORTAL_URL=https://community.365labs.com/f160b8ff-b432-4575-ad6d-6fddac1b1aaa/inmatelist
# Restrict browser access to your deployed operator app in production.
BAILBONDS_ALLOWED_ORIGIN=http://127.0.0.1:8787
# Set to 1 only behind HTTPS in production. Leave unset for local development.
BAILBONDS_ENABLE_HSTS=
# A signed internal adapter that delivers SMS, email, or pager messages. The
# app never claims external delivery until this is configured and returns 2xx.
BAILBONDS_NOTIFICATION_WEBHOOK_URL=
BAILBONDS_NOTIFICATION_WEBHOOK_SECRET=
ADTV_REVENUE_WEBHOOK_SECRET=

# Attention Contribution is OFF until every admin toggle is explicitly enabled.
# Use a provider contract that permits sponsor-funded charitable campaigns;
# ordinary AdMob rewarded ads must not fund cash, tokens, or third-party donations.
ATTENTION_PROVIDER_WEBHOOK_SECRET=
BBT_UNITS_PER_USD_CENT=1
BBT_ASSET_SYMBOL=BBT

# Non-custodial EVM wallet billing; keep RPC URLs and payment address in the backend secret manager.
CRYPTO_PAYMENT_ADDRESS=
CRYPTO_RPC_URL=
CRYPTO_CHAIN_ID=0x1
CRYPTO_ASSET=native
CRYPTO_PRICE_STARTER_WEI=
CRYPTO_PRICE_PROFESSIONAL_WEI=
CRYPTO_PRICE_AGENCY_WEI=

# Utility accounting pegs (integer cents): 1 918 = $1,000; 1 BBT = $0.10
TOKEN_918_USD_CENTS=100000
TOKEN_BBT_USD_CENTS=10
TOKEN_TIER_PREPARED_MIN_USD_CENTS=10
TOKEN_TIER_STANDARD_MIN_USD_CENTS=10000
TOKEN_TIER_PRIORITY_MIN_USD_CENTS=100000
TOKEN_STANDARD_MAX_PREAPPROVED_USD=0
TOKEN_PRIORITY_MAX_PREAPPROVED_USD=0
